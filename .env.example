# ---------------------------------------------------------------------------
# meta-invoices — copia este fichero a `.env` y rellena los valores.
# `.env` está en .gitignore y NUNCA debe commitearse.
# ---------------------------------------------------------------------------

# --- IMAP (buzón donde llegan las facturas de Meta) ------------------------
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=facturacion@ejemplo.com
# Para Gmail usa una "contraseña de aplicación", no la contraseña de la cuenta.
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# --- Microsoft Graph / OneDrive -------------------------------------------
# Application (client) ID del registro de app en Entra ID.
GRAPH_CLIENT_ID=
# "common" para cuentas personales+organizativas, "consumers" para personales,
# o el tenant id concreto para una organización.
GRAPH_TENANT_ID=common
# Fichero donde MSAL persiste el token cache (refresh token). En .gitignore.
TOKEN_CACHE_PATH=token_cache.json

# --- Mapa de cuentas publicitarias -> carpeta de destino en OneDrive -------
# JSON: {"act_id": "nombre_carpeta"}. Deben ser exactamente 4 cuentas.
ACCOUNT_MAP={"act_111111111111111": "Cliente A", "act_222222222222222": "Cliente B", "act_333333333333333": "Cliente C", "act_444444444444444": "Cliente D"}

# --- Rutas y almacenamiento local -----------------------------------------
# Carpeta raíz en OneDrive bajo la que se crea {nombre_carpeta}/{YYYY-MM}/...
ONEDRIVE_ROOT=/Facturas Meta
# Base de datos SQLite del ledger de idempotencia. En .gitignore.
LEDGER_PATH=ledger.db

# --- Comportamiento --------------------------------------------------------
# Remitente esperado de los correos de Meta.
SENDER_DOMAIN=facebookmail.com
# Si es 1, no sube nada ni marca correos como leídos (sólo loguea).
DRY_RUN=0
